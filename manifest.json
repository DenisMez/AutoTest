{
  "manifest_version": 3,
  "name": "Облтех — чек-лист из Jira",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "description": "Создаёт чек-листы в Яндекс Формах и выгружает результаты тестирования в Word.",
  "permissions": ["scripting", "storage", "sidePanel"],
  "host_permissions": ["https://jira.mos.social/*", "https://api.forms.yandex.net/*"],
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {
    "default_title": "Облтех — чек-листы и Word",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}
  },
  "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}}},
  "side_panel": {"default_path": "index.html"},
  "background": {"service_worker": "background.js"}
}
